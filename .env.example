# Copiar este archivo como .env (o exportar estas variables en tu sistema/IDE)
# NUNCA subir el .env real a GitHub - ya esta en .gitignore

# --- Azure AD / Microsoft Entra ID ---
# Tenant ID del directorio donde registraron las apps (Overview de cualquiera de las 2 apps)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Client ID de la app "Pedidos360-API" (el backend/BFF valida que los tokens sean para este audience)
AZURE_CLIENT_ID_BACKEND=00000000-0000-0000-0000-000000000000

# Client ID de la app "Pedidos360-Frontend" (SPA) - lo usa Angular/MSAL, no el backend,
# pero lo dejamos aca de referencia para no perderlo.
AZURE_CLIENT_ID_FRONTEND=00000000-0000-0000-0000-000000000000

# --- Base de datos (pedidos-service) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pedidos360
DB_USERNAME=root
DB_PASSWORD=root

# --- Comunicacion interna BFF -> pedidos-service ---
# En local: http://localhost:8081
# En EC2 (si estan en instancias separadas): usar la IP privada o DNS interno
PEDIDOS_SERVICE_URL=http://localhost:8081
